{
  "name": "local-workspace-bridge",
  "version": "0.2.0",
  "description": "A local MCP gateway that gives ChatGPT bounded repository context, file and image access, direct workspace edits, command verification, and change review.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nippori709/AgentDock.git"
  },
  "homepage": "https://github.com/Nippori709/AgentDock#readme",
  "bugs": {
    "url": "https://github.com/Nippori709/AgentDock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "agent",
    "developer-tools",
    "repository-analysis",
    "local-development"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*.js",
    "scripts/local-workspace-bridge.mjs",
    "scripts/image-worker.py",
    "scripts/document-worker.py",
    "scripts/runtime/status.mjs",
    "README.md",
    "README_ZH.md",
    "README_JA.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LINUX_SERVER.md",
    "LICENSE",
    "config.example.env",
    "CHATGPT_PROMPT.md",
    "AGENT_TOOLS.md",
    "CHANGELOG.md",
    "control-center/*.mjs",
    "control-center/*.md",
    "control-center/package.json",
    "control-center/backend/**",
    "control-center/renderer/**",
    "control-center/scripts/runtime-node.mjs",
    "control-center/scripts/doctor.mjs",
    "control-center/scripts/install.mjs",
    "control-center/scripts/uninstall.mjs",
    "control-center/scripts/desktop.mjs",
    "control-center/scripts/preview.mjs",
    "control-center/scripts/run-hidden.vbs"
  ],
  "bin": {
    "local-workspace-bridge": "scripts/local-workspace-bridge.mjs",
    "local-workspace-bridge-mcp": "dist/stdio.js",
    "local-workspace-bridge-mcp-http": "dist/http.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/smoke-all.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "benchmark:quick": "npm run build && node benchmarks/run.mjs --quick",
    "proxy:smoke": "npm run build && node scripts/proxy-smoke.mjs",
    "document:smoke": "npm run build && node scripts/document-smoke.mjs",
    "doctor": "node scripts/local-workspace-bridge.mjs doctor",
    "connect": "node scripts/local-workspace-bridge.mjs",
    "connect:setup": "node scripts/local-workspace-bridge.mjs setup",
    "connect:local": "node scripts/local-workspace-bridge.mjs --tunnel none",
    "connect:cloudflare": "node scripts/local-workspace-bridge.mjs --tunnel cloudflare",
    "connect:ngrok": "node scripts/local-workspace-bridge.mjs ngrok",
    "connect:tailscale": "node scripts/local-workspace-bridge.mjs tailscale",
    "control-center:start": "node control-center/server.mjs",
    "control-center:test": "node --test control-center/test/controller.test.mjs control-center/test/runtime-node.test.mjs",
    "control-center:smoke": "node control-center/scripts/apply-smoke.mjs && node control-center/scripts/control-server-smoke.mjs && node control-center/scripts/integration-smoke.mjs",
    "control-center:layout": "node control-center/scripts/layout-smoke.mjs",
    "control-center:install": "npm run build && node control-center/scripts/install.mjs",
    "control-center:doctor": "node control-center/scripts/doctor.mjs",
    "control-center:uninstall": "node control-center/scripts/uninstall.mjs",
    "agent:smoke": "npm run build && node scripts/agent-tools-smoke.mjs",
    "browser:smoke": "npm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ignore": "^7.0.6",
    "minimatch": "^10.0.1",
    "zod": "^4.4.3",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
