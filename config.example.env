# Workspace
LOCALWORKSPACEBRIDGE_ROOT=/absolute/path/to/your/repo
LOCALWORKSPACEBRIDGE_ALLOWED_ROOTS=/absolute/path/to

# Local MCP server
LOCALWORKSPACEBRIDGE_HOST=127.0.0.1
LOCALWORKSPACEBRIDGE_PORT=8787
LOCALWORKSPACEBRIDGE_TOOL_MODE=standard
LOCALWORKSPACEBRIDGE_WRITE_MODE=workspace
LOCALWORKSPACEBRIDGE_BASH_MODE=safe
# Default surface mirrors Claude Code's local harness where MCP permits it.
LOCALWORKSPACEBRIDGE_HARNESS_PROFILE=claude
# Local .claude/settings*.json command hooks are opt-in because MCP has no
# Claude Code repository-trust prompt.
LOCALWORKSPACEBRIDGE_HOOKS=0
# Optional explicit path to a Claude-compatible .lsp.json file. This is not
# auto-loaded from an untrusted repository because it can execute commands.
# LOCALWORKSPACEBRIDGE_LSP_CONFIG=.lsp.json

# Optional shell selection. "auto" uses PowerShell on Windows and Bash elsewhere.
# LOCALWORKSPACEBRIDGE_SHELL=auto
# LOCALWORKSPACEBRIDGE_BASH_PATH=C:\Program Files\Git\bin\bash.exe
# LOCALWORKSPACEBRIDGE_BASH_SESSION_ID=main
# LOCALWORKSPACEBRIDGE_REQUIRE_BASH_SESSION=1

# Authentication. Use a real secret only in your local environment/profile; never commit it.
# LOCALWORKSPACEBRIDGE_HTTP_TOKEN=[REDACTED_SECRET]
LOCALWORKSPACEBRIDGE_ALLOW_QUERY_TOKEN=0

# Stable public URL enables OAuth discovery/PKCE for HTTP MCP.
# LOCALWORKSPACEBRIDGE_PUBLIC_URL=https://gateway.example.com

# Custom tool cards are disabled by default. If enabled for an app submission,
# use a dedicated HTTPS origin you control.
LOCALWORKSPACEBRIDGE_TOOL_CARDS=0
# LOCALWORKSPACEBRIDGE_WIDGET_DOMAIN=https://widgets.example.com

# Fine-grained tool permissions. denylist keeps current behavior and only blocks
# explicit rules. strict requires allow rules for mutating/open-world tools.
LOCALWORKSPACEBRIDGE_PERMISSION_POLICY=denylist
# LOCALWORKSPACEBRIDGE_PERMISSION_ALLOW_RULES=Bash(npm test*);Edit(src/**)
# LOCALWORKSPACEBRIDGE_PERMISSION_DENY_RULES=Bash(git push --force*);Write(C:\Windows\**)

# Oversized tool results keep a bounded inline preview and, when writes are
# enabled, retain the redacted full result under .ai-bridge/tool-results/.
LOCALWORKSPACEBRIDGE_TOOL_RESULT_RETENTION=1
LOCALWORKSPACEBRIDGE_MAX_TOOL_RESULT_BYTES=20971520

# Repository analysis is opt-in. The default exploration path is
# tree/glob/grep/LSP/read/read_many, letting a strong model navigate directly.
LOCALWORKSPACEBRIDGE_ANALYSIS=0
# Set to 1 to expose inspect_workspace and structured search.
# LOCALWORKSPACEBRIDGE_LOW_MEMORY=1
# LOCALWORKSPACEBRIDGE_ANALYSIS_IGNORE_GLOBS=**/generated/**,**/fixtures/**

# Optional outbound proxy used by tunnel setup/downloads and public health checks.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# Optional stable tunnel profile
# LOCALWORKSPACEBRIDGE_TUNNEL=ngrok
# LOCALWORKSPACEBRIDGE_PUBLIC_HOSTNAME=your-name.ngrok-free.dev

# Optional local Codex history. Default: off
# LOCALWORKSPACEBRIDGE_CODEX_SESSIONS=metadata
